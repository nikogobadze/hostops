{
  "name": "hostops",
  "version": "2.0.0",
  "private": true,
  "description": "Magnolia House — hotel website and the HostOps management panel behind it",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python serve.py 8080",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --drop && node scripts/seed.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  },
  "license": "UNLICENSED"
}
